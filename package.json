{
  "name": "imagic-jollyrp",
  "version": "1.0.3",
  "description": "Premium Uncensored AI Roleplay Client",
  "author": "JollyRP <contact@jollyrp.com>",
  "homepage": "https://jollyrp.com",
  "license": "MIT",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "test": "node test-runner.js",
    "dist:win": "vite build && electron-builder --win",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "electron": "^30.0.8",
    "electron-builder": "^24.13.3",
    "vite": "^5.2.11"
  },
  "build": {
    "appId": "com.jollyrp.app",
    "productName": "JollyRP",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/server.js",
      "main.js",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png"
    }
  }
}